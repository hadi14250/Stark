# ── Contact form (Phase 2) ───────────────────────────────────────────────────
# Resend API key. If UNSET, the form logs the lead to the server console instead
# of sending email — safe local dev with no account needed. Set in Vercel for
# preview/production (never commit the real key).
RESEND_API_KEY=

# Where lead emails are delivered.
# ⚠ F6 — client must confirm the real destination inbox. Placeholder below.
CONTACT_TO_EMAIL=hello@stark-ksa.net

# Verified sending identity. The dev fallback is Resend's shared onboarding
# sender, which works without domain verification for testing.
# ⚠ F6 — production requires a domain verified in Resend (SPF/DKIM/DMARC),
# e.g. leads@<confirmed-domain>.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ── Cloudflare Turnstile (deferred; leave BOTH blank to disable) ──────────────
# The CAPTCHA layer is scaffolded but inert until both keys are provided.
# ⚠ Client must create a Cloudflare Turnstile widget and supply both keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# ── Existing (used by src/lib/seo.ts) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
