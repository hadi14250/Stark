# ---- Next.js app (web/) ----
web/node_modules
web/.next
web/out
web/build
web/.vercel
web/.env*
!web/.env.example
web/next-env.d.ts
web/*.tsbuildinfo

# ---- OS / editor ----
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---- Heavy reference binaries (kept in stark-website-clutter, not versioned) ----
# Keep the curated image set (extracted-images) but skip multi-MB source docs.
stark-website-clutter/**/*.pdf
stark-website-clutter/**/*.pptx
stark-website-clutter/**/*.xlsx
stark-website-clutter/**/*.PDF

# Node in clutter demos (none currently, but guard against it)
stark-website-clutter/**/node_modules

stark-website-clutter

# ---- Design source + handoffs (kept locally, not versioned) ----
# The Figma source and the reference HTML prototypes aren't needed to build the
# app — the assets the site serves live in web/public/landing/.
*.fig
design_handoff_furniture_landing/
design_handoff_furniture_landing_mobile/